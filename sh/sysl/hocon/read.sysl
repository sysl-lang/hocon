module sh.sysl.hocon

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{parse_long, parse_real, str_builder}

// The value tree, derived from the lossless tree `syntax` reads.
//
// Every refusal of a document is the reading's (`syntax.sysl`): this half gives meaning to what was
// written and cannot fail. A dotted key becomes nested objects, a name written twice merges or is
// replaced, a bare word becomes the number, boolean or `null` it spells, and text written side by
// side becomes one string.

/** A document read and resolved: every substitution replaced by what it names. */
parse(src: Source) -> Result[Document, Diagnostic]
    val doc = parse_unresolved(src)?

    Ok(Document(resolve(src, doc.root)?, doc.repeats))
end parse

/** A document read as written, with its substitutions, concatenations and merges left in place. */
parse_unresolved(src: Source) -> Result[Document, Diagnostic]
    val tree = syntax(src)?
    var repeats: Buf[Repeat] = buf()
    val root = value_of(&repeats, tree.root, buf())

    Ok(Document(root, repeats))
end parse_unresolved

/** The value tree of a document already read into its lossless tree. */
values_of(tree: Syntax) -> Document
    var repeats: Buf[Repeat] = buf()
    val root = value_of(&repeats, tree.root, buf())

    Document(root, repeats)
end values_of

// A written value as a value. `path` is where it is being filed, which an object inside it carries as
// its prefix. A value of one part that is a bare word is turned into what it spells.
private value_of(repeats: *Buf[Repeat], n: Node, path: Buf[string]) -> Value
    n.kind match
        NJoined(written) ->
            var parts: Buf[Value] = buf()

            for p in written
                parts.push(part_of(repeats, p, path))

            joined_value(n.span, parts)
        _ -> scalar(part_of(repeats, n, path))
end value_of

private part_of(repeats: *Buf[Repeat], n: Node, path: Buf[string]) -> Value
    n.kind match
        NBlock(entries, _) ->
            var fields: Buf[Field] = buf()

            for e in entries
                val names = e.names()
                val v = value_of(repeats, e.value, joined(path, names))

                file_path(repeats, &fields, path, e.path, v)

            Value(n.span, Obj(fields))
        NList(items) ->
            var out: Buf[Value] = buf()

            for item in items
                out.push(value_of(repeats, item, buf()))

            Value(n.span, Arr(out))
        NQuoted(s) -> Value(n.span, Str(s))
        NBare(s) -> Value(n.span, Word(s))
        NRef(p, optional) -> Value(n.span, Subst(p, optional))
        NJoined(_) -> value_of(repeats, n, path)
end part_of

// Text written side by side with nothing to resolve is one string now: `a = hello world` is the
// word `hello world`, and `a = "x" y` the string `x y`. Anything else is a concatenation.
private joined_value(span: Span, parts: Buf[Value]) -> Value
    var plain = true
    var quoted_part = false

    for p in parts
        p.kind match
            Word(_) -> ()
            Str(_) -> quoted_part = true
            _ -> plain = false

    if plain then
        var b = str_builder()

        for p in parts
            b.push(p.as_text().unwrap())

        val text = b.finish()

        return Value(span, if quoted_part then Str(text) else Word(text))
    end if

    Value(span, Concat(parts))
end joined_value

// Files a value under a path into the fields being read, nesting a dotted path into the objects it
// names.
private file_path(repeats: *Buf[Repeat], fields: *Buf[Field], prefix: Buf[string], path: Buf[Key], value: Value)
    var v = value
    var i = path.len() - 1

    // From the innermost segment outward: `a.b.c = 1` is `a { b { c = 1 } }`, with `a` and `b`
    // implied. The innermost field is the one the document wrote.
    while i > 0
        var inner: Buf[Field] = buf()

        inner.push(Field(path.at(i).name, path.at(i).span, v, i < path.len() - 1))
        v = Value(path.at(i).span.to(v.span), Obj(inner))
        i -= 1

    put(repeats, fields, prefix, Field(path.at(0).name, path.at(0).span, v, path.len() > 1))
end file_path

// One field into an object's fields. **A name already there is HOCON's merge**: two objects become
// one, a later plain value replaces whatever was there, and anything not known until resolution --
// a substitution, a concatenation -- is kept as a merge of layers for the resolver to decide.
private put(repeats: *Buf[Repeat], fields: *Buf[Field], prefix: Buf[string], f: Field)
    for i in 0..<fields.len()
        val old = fields.at(i)

        if old.key == f.key then
            val here = joined1(prefix, f.key)

            if !old.implied && !f.implied then
                repeats.push(Repeat(path_text(here), old.key_span, f.key_span))

            val merged = old.value.kind match
                Obj(was) ->
                    f.value.kind match
                        Obj(now) ->
                            var acc: Buf[Field] = buf()

                            for g in was
                                acc.push(g)

                            for g in now
                                put(repeats, &acc, here, g)

                            Value(old.value.span, Obj(acc))
                        _ -> layered(old.value, f.value)
                _ -> layered(old.value, f.value)

            fields.set(i, Field(old.key, old.key_span, merged, old.implied && f.implied))
            return
        end if
    end for

    fields.push(f)
end put

// What a key holds when it is set again and the earlier setting is not an object the later merges
// into. A plain value on top replaces everything under it; anything else is a layer.
private layered(below: Value, top: Value) -> Value
    if !unresolved(top) && !top.is_obj() then return top

    var layers: Buf[Value] = buf()

    below.kind match
        Merge(was) ->
            for l in was
                layers.push(l)
        _ -> layers.push(below)

    layers.push(top)
    Value(below.span.to(top.span), Merge(layers))
end layered

private unresolved(v: Value) -> bool = v.kind match
    Subst(_, _) -> true
    Concat(_) -> true
    Merge(_) -> true
    _ -> false

private joined(prefix: Buf[string], path: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for p in prefix
        out.push(p)

    for p in path
        out.push(p)

    out
end joined

private joined1(prefix: Buf[string], key: string) -> Buf[string]
    var out: Buf[string] = buf()

    for p in prefix
        out.push(p)

    out.push(key)
    out
end joined1

// A bare word standing alone, turned into what it spells: a number, `true`, `false`, `null`.
private scalar(v: Value) -> Value
    v.kind match
        Word(w) ->
            if w == "true" then
                Value(v.span, Bool(true))
            elif w == "false" then
                Value(v.span, Bool(false))
            elif w == "null" then
                Value(v.span, Null)
            elif is_number_text(w.bytes) then
                Value(v.span, number_of(w))
            else
                v
        _ -> v
end scalar

private number_of(w: string) -> Kind
    var whole = true

    for c in w.bytes
        if c == u8('.') || c == u8('e') || c == u8('E') then whole = false

    if whole then
        parse_long(w) match
            Ok(n) -> return Int(n, w)
            Err(_) -> ()

    parse_real(w) match
        Ok(x) -> Real(x, w)
        Err(_) -> Word(w)
end number_of
