module sh.sysl.hocon

import sh.sysl.parsing.{Diagnostic, Source, Span, error}
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// Substitutions, concatenations and merges, replaced by what they come to.
//
// **A substitution names a path from the top of the document**, wherever it is written, and what it
// names is resolved first -- so `${a}` where `a` is itself `${b}` is `b`'s value. A path being
// resolved is on a stack, and a substitution that reaches a path already on it is a cycle: `a =
// ${a}`, or `a { b = ${a} }`, where `a` cannot be known until `b` is.
//
// **Environment variables are not consulted.** The specification falls back to one where a path is
// missing; this package reads text a caller already has and touches nothing else, so a missing path
// is an error unless it was written `${?path}`, and a caller that wants the environment in a document
// puts it in the text.

private struct Resolver
    src: Source
    root: Value
    stack: Buf[string]
end Resolver

/** A tree with every substitution, concatenation and merge replaced by what it comes to. */
resolve(src: Source, root: Value) -> Result[Value, Diagnostic]
    var r = Resolver(src, root, buf())

    walk(&r, root, buf()) match
        Ok(Some(v)) -> Ok(v)
        Ok(None) -> Ok(Value(root.span, Obj(buf())))
        Err(d) -> Err(d)
end resolve

// One value resolved, at a path. `None` is a `${?path}` that named nothing, which leaves its field
// unset rather than set to anything.
private walk(r: *Resolver, v: Value, path: Buf[string]) -> Result[Option[Value], Diagnostic]
    v.kind match
        Obj(fields) ->
            var out: Buf[Field] = buf()

            for f in fields
                val here = child(path, f.key)

                r.stack.push(stack_key(here))

                val got = walk(r, f.value, here)

                r.stack.pop()

                got? match
                    Some(x) -> out.push(Field(f.key, f.key_span, x, f.implied))
                    None -> ()
            end for

            Ok(Some(Value(v.span, Obj(out))))
        Arr(items) ->
            var out: Buf[Value] = buf()

            for item in items
                walk(r, item, path)? match
                    Some(x) -> out.push(x)
                    None -> ()

            Ok(Some(Value(v.span, Arr(out))))
        Subst(target, optional) -> lookup(r, target, optional, v.span)
        Concat(parts) -> concat(r, v.span, parts, path)
        Merge(layers) ->
            var acc: Option[Value] = None

            for layer in layers
                walk(r, layer, path)? match
                    None -> ()
                    Some(x) ->
                        acc = acc match
                            Some(a) -> Some(if a.is_obj() && x.is_obj() then merged(a, x) else x)
                            None -> Some(x)
            end for

            Ok(acc)
        _ -> Ok(Some(v))
end walk

// What a substitution names.
private lookup(r: *Resolver, target: Buf[string], optional: bool, span: Span) -> Result[Option[Value], Diagnostic]
    var node = r.root
    var walked: Buf[string] = buf()

    for seg in target
        // An object reached through something still to be resolved is resolved first, so that a path
        // can run into a value that was itself built by a substitution.
        if unresolved_kind(node) then
            node = resolved_at(r, node, walked, target, span)? match
                Some(x) -> x
                None -> return missing(target, optional, span)

        node.get(seg) match
            Some(x) -> node = x
            None -> return missing(target, optional, span)

        walked.push(seg)
    end for

    resolved_at(r, node, walked, target, span)? match
        Some(x) -> Ok(Some(x))
        None -> missing(target, optional, span)
end lookup

private resolved_at(r: *Resolver, node: Value, at: Buf[string], target: Buf[string], span: Span) -> Result[Option[Value], Diagnostic]
    val key = stack_key(at)

    for k in r.stack
        if k == key then
            return Err(error(span, s"a substitution cycle: `${subst_text(target)}` needs its own value")
                .with_note("a value that refers to itself, or to an object it is part of, cannot be resolved; a setting that adds to its own earlier value is not supported"))

    r.stack.push(key)

    val got = walk(r, node, at)

    r.stack.pop()
    got
end resolved_at

private subst_text(target: Buf[string]) -> string
    var b = str_builder()

    b.push("${")
    b.push(path_text(target))
    b.push("}")
    b.finish()
end subst_text

private missing(target: Buf[string], optional: bool, span: Span) -> Result[Option[Value], Diagnostic]
    if optional then return Ok(None)

    Err(error(span, s"no value at `${subst_text(target)}`")
        .with_note("a substitution names a path from the top of the document; environment variables are not consulted"))
end missing

// Values written side by side. Objects merge, arrays join, and everything else is text: a number is
// the text it was written as, so `${major}.${minor}` is `1.2` and not `1.0.2.0`.
private concat(r: *Resolver, span: Span, parts: Buf[Value], path: Buf[string]) -> Result[Option[Value], Diagnostic]
    var got: Buf[Value] = buf()
    var gaps: Buf[bool] = buf()

    for p in parts
        val gap = is_gap(p)

        walk(r, p, path)? match
            Some(x) ->
                got.push(x)
                gaps.push(gap)
            None -> ()
    end for

    // The first part that is not whitespace says what the whole is.
    var first: Option[Value] = None

    for i in 0..<got.len()
        if !gaps.at(i) && first.is_none() then first = Some(got.at(i))

    val lead = first match
        Some(x) -> x
        None -> return Ok(None)

    if lead.is_obj() || lead.is_arr() then
        var acc = lead
        var seen = false

        for i in 0..<got.len()
            if gaps.at(i) then continue

            val x = got.at(i)

            if !seen then
                seen = true
                continue
            end if

            if lead.is_obj() && x.is_obj() then
                acc = merged(acc, x)
            elif lead.is_arr() && x.is_arr() then
                var items: Buf[Value] = buf()

                for a in acc.items()
                    items.push(a)

                for b in x.items()
                    items.push(b)

                acc = Value(acc.span.to(x.span), Arr(items))
            else
                return Err(error(x.span, s"cannot concatenate ${lead.kind_name()} with ${x.kind_name()}"))
        end for

        return Ok(Some(Value(span, acc.kind)))
    end if

    var b = str_builder()

    for i in 0..<got.len()
        val x = got.at(i)

        if x.is_obj() || x.is_arr() then
            return Err(error(x.span, s"cannot concatenate ${lead.kind_name()} with ${x.kind_name()}"))

        b.push(text_of(r, x))
    end for

    Ok(Some(Value(span, Str(b.finish()))))
end concat

private is_gap(v: Value) -> bool = v.kind match
    Word(w) ->
        var all = !w.is_empty()

        for c in w.bytes
            if c != u8(' ') && c != u8('\t') then all = false

        all
    _ -> false

// A scalar's text in a concatenation: a number as it was written.
private text_of(r: *Resolver, v: Value) -> string
    v.kind match
        Str(s) -> s
        Word(s) -> s
        Bool(b) -> if b then "true" else "false"
        Null -> "null"
        _ -> v.as_word().unwrap_or("")
end text_of

/** Two objects as one, the second on top: a field in both that is an object in both is merged in
 * turn, and any other field of the second replaces the first's. The result is a new tree; neither
 * argument is changed.
 */
merged(below: Value, top: Value) -> Value
    var out: Buf[Field] = buf()

    for f in below.fields()
        out.push(f)

    for f in top.fields()
        var found = false

        for i in 0..<out.len()
            val old = out.at(i)

            if old.key == f.key then
                val v = if old.value.is_obj() && f.value.is_obj() then merged(old.value, f.value) else f.value

                out.set(i, Field(old.key, old.key_span, v, old.implied && f.implied))
                found = true
                break
            end if
        end for

        if !found then out.push(f)
    end for

    Value(below.span, Obj(out))
end merged

private unresolved_kind(v: Value) -> bool = v.kind match
    Subst(_, _) -> true
    Concat(_) -> true
    Merge(_) -> true
    _ -> false

private child(path: Buf[string], key: string) -> Buf[string]
    var out: Buf[string] = buf()

    for p in path
        out.push(p)

    out.push(key)
    out
end child

// A path as one string for the stack. The separator is a byte no key holds in practice, so `a.b` the
// path and `"a.b"` the one key are two entries.
private stack_key(path: Buf[string]) -> string
    var b = str_builder()

    for p in path
        b.push(p)
        b.push("\u{1f}")

    b.finish()
end stack_key
